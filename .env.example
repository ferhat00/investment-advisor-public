# Optional environment variables for the tools/ library.
# Everything works with all of these UNSET — premium seams return None and the
# tools degrade to free primitives (yfinance + keyless FRED), stating what's missing.

# --- Premium data-feed seams (tools/common.py::_vendor_get) ---
# Securities-lending / borrow data (S3, S&P Global, DataLend, Ortex, IBKR SLB):
#   consumed by crowding_metrics.py
BORROW_FEED_URL=
BORROW_FEED_KEY=

# Fund-flow / forced-seller data (MFFlow, index-reconstitution calendars):
#   consumed by flow_pressure.py
FLOW_FEED_URL=
FLOW_FEED_KEY=

# Retail attention / social sentiment (Google SVI, StockTwits/Twitter):
#   consumed by retail_attention.py
ATTENTION_FEED_URL=
ATTENTION_FEED_KEY=

# Contact email sent in the SEC EDGAR User-Agent header, per EDGAR's fair-use
# policy (tools/edgar_filings.py). Defaults to a placeholder if unset.
# EDGAR_CONTACT_EMAIL=

# --- Overrides (rarely needed) ---
# Deferred-contract symbol override per market for commodity curve state,
# e.g. COMMODITY_CURVE_GOLD=GCM27.CMX (tools/commodity_carry.py)
# COMMODITY_CURVE_<MARKET>=

# Custom Loughran-McDonald dictionary path (tools/lm_dictionary.py)
# LM_DICT_PATH=

# Custom Baker-Wurgler sentiment series path (tools/sentiment_regime.py)
# BW_SENT_PATH=
